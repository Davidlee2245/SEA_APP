{
  "name": "sea-exosome-analysis",
  "version": "1.0.0",
  "description": "SEA — Semiautomated Exosome Analysis Desktop App",
  "main": "main.js",
  "scripts": {
    "start":      "electron .",
    "pack-test":  "electron-builder --dir --linux --config.extraResources=[]",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:win":   "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.lab.sea",
    "productName": "SEA Exosome Analysis",
    "copyright": "Copyright © 2026",
    "asar": true,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "settings.html"
    ],
    "extraResources": [
      { "from": "../agents",                 "to": "app/agents"                 },
      { "from": "../core",                   "to": "app/core"                   },
      { "from": "../utils",                  "to": "app/utils"                  },
      { "from": "../exosome_detection",      "to": "app/exosome_detection"      },
      { "from": "../config",                 "to": "app/config"                 },
      { "from": "../checkpoints",            "to": "app/checkpoints"            },
      { "from": "../api_server_extended.py", "to": "app/api_server_extended.py" },
      { "from": "../pipeline.py",            "to": "app/pipeline.py"            },
      { "from": "../frontend/dist",          "to": "app/frontend/dist"          }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "SEA Exosome Analysis",
      "installerSidebar": false
    },
    "linux": {
      "target": "AppImage",
      "category": "Science"
    }
  }
}
